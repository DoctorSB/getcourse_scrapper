# ---- Какой сайт качаем -------------------------------------------------
# Адрес вашего getcourse-сайта, без слэша на конце.
SCRAPPER_BASE_URL=https://example.getcourse.ru

# Имя папки с конфигом курса: config/trainings/<это значение>/trainings.json
SCRAPPER_TRAINING_CONFIG_DIR=example.getcourse.ru

# ---- Куда складывать видео ---------------------------------------------
SCRAPPER_DOWNLOAD_PATH="./download"

# ---- Авторизация -------------------------------------------------------
# Основной способ — окно браузера: `npm run login` или кнопка в интерфейсе.
# Резервный — cookie сессии из DevTools (Application → Cookies).
# auth-state.json, если он есть, имеет приоритет над этими значениями.
#SCRAPPER_AUTH_COOKIE_NAME=PHPSESSID5
#SCRAPPER_AUTH_COOKIE_VALUE=
#SCRAPPER_AUTH_COOKIE_DOMAIN=.example.getcourse.ru

# ---- Выгрузка на Яндекс Диск -------------------------------------------
# Токен OAuth, инструкция — в README. Это секрет, не публикуйте его.
YADISK_TOKEN=
YADISK_BASE_PATH=disk:/getcourse
# Как часто интерфейс проверяет папку загрузок, секунд.
#YADISK_INTERVAL_SECONDS=120

# ---- Нагрузка ----------------------------------------------------------
# Сколько уроков открывать одновременно и сколько видео качать параллельно.
# Повышать осторожно — это запросы к чужому серверу.
SCRAPPER_CONCURRENCY=3
SCRAPPER_DOWNLOAD_CONCURRENCY=2

# ---- Интерфейс ---------------------------------------------------------
#SCRAPPER_UI_PORT=4321
